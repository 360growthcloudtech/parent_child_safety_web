# Supabase Postgres via the Session pooler (Dashboard → Connect → Session pooler).
# URL-encode special characters in the password (? → %3F, ! → %21, @ → %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Shared secret the child app sends in the x-ingest-token header when uploading frames.
INGEST_TOKEN=change-me-to-a-long-random-string

# Secret used to sign the parent session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL the child devices use to reach this server (LAN IP in dev).
PUBLIC_BASE_URL=http://192.168.1.46:3000
# Firebase service account JSON (whole file as one line) for sending FCM pushes.
# FCM_SERVICE_ACCOUNT={"type":"service_account",...}
